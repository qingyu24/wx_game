{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/App.jsx",
    "src/main.tsx",
    "src/rpg/**/*",
    "vite.config.ts"
  ]
}