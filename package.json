{
  "name": "mist-lantern-rpg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "lint": "tsc --noEmit",
    "test:browser": "node tests/browser/smoke.mjs && node tests/browser/action.mjs",
    "build:offline": "npm run build && node scripts/offline.mjs",
    "format": "prettier --write src scripts tests docs README.md",
    "test:offline": "node tests/browser/offline.mjs",
    "test:action": "node tests/browser/action.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.51.1",
    "prettier": "^3.5.3",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
